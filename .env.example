# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID / VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID for Google Sign-In
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT_SECRET: Secret key for signing and verifying user session JWT tokens
JWT_SECRET="your-secure-jwt-secret-key"

# MONGO_URI (Optional): MongoDB connection URI for persistent Mongoose storage.
# If omitted, the server seamlessly uses persistent file-backed JSON storage.
MONGO_URI="mongodb://localhost:27017/sanctuary_clinic"
